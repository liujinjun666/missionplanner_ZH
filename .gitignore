# .workbuddy 为工具内部目录（含大量缓存），不纳入版本库
.workbuddy/

# 临时/系统文件
*.tmp
*.bak
Thumbs.db
desktop.ini
~$*
.DS_Store

# 部署脚本用不到的本地产物
*.log

# ───────── 不推送：调试 / 测试文件 ─────────
zh-diag.cs
test_script.lua
verify_lua_v12.py

# ───────── 不推送：旧版本安装包（只保留最新 v1.2）─────────
packages/ECU双向控制方案/玄云ECU双向控制方案_v1.1/
packages/ECU双向控制方案/*_v1.1.rar

# ───────── 不推送：发布归档压缩包（源文件见 packages/ECU双向控制方案/…_v1.2/）─────────
packages/**/*.zip
packages/**/*.rar

# ───────── 不推送：厂商第三方工具（非本项目成果，体积大）─────────
官网文件/

# ───────── 不推送：产品实拍图（隐私风险，仅本地保留）─────────
图片/
